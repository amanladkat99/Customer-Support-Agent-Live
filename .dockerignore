# Python virtual environment — never copy the local venv into the image.
# The Dockerfile runs `uv sync` to build a clean one inside the container.
.venv/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Local data — mounted as volumes at runtime instead
data/

# Dev / editor artifacts
.env
.env.*
*.env
.git/
.gitignore
.DS_Store

# Notebooks and debug scripts
notebooks/
debug_memory.py

# Test artifacts
.pytest_cache/
htmlcov/
.coverage

